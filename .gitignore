# Keep the full CV (with phone number / personal details) out of the public repo.
# The public CV is delivered only as a PDF (diego_dreier_cv_public.pdf, tracked);
# all CV *.html sources — including the redacted cv_public_en.html — stay out of the repo.
public/static/cv/cv.html
public/static/cv/cv_en.html
public/static/cv/cv.pdf
public/static/cv/cv_en.pdf
public/static/cv/cv_public_en.html

# Application context / personal working notes — not for the public repo
Context/

# Job application materials (cover letter etc.) — private, not for the public repo
application/

# Recommendation letters / references — private, not for the public repo
recommendation/
Recommendation/

